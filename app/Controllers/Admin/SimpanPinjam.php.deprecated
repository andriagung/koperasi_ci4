            else if($row['status_pengajuan'] == 'Ditolak') $statusBadge = '<span class="status-badge status-rejected">Ditolak</span>';
            else $statusBadge = '<span class="status-badge status-pending">Menunggu</span>';
            
            $actionBtn = '';
