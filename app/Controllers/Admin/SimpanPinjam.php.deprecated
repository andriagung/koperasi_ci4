            } else {
                $actionBtn = '<div class="action-btns"><button class="btn-action edit" onclick="showBuktiSetor(\''.base_url('uploads/bukti_setor/'.$row['bukti_transfer']).'\')" title="Lihat Bukti"><i class="fas fa-image"></i></button></div>';
